# Environment Configuration
# Copy this file to .env and fill in your values

# --- App ---
APP_NAME=AI-Workbench
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# --- Server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173

# --- Database (PostgreSQL) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=workbench
POSTGRES_PASSWORD=workbench_dev_2026
POSTGRES_DB=ai_workbench
DATABASE_URL=postgresql+asyncpg://workbench:workbench_dev_2026@postgres:5432/ai_workbench

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

# --- JWT ---
JWT_SECRET_KEY=change-me-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- AI Models ---
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Search ---
SEARCH_PROVIDER=mock
SEARCH_API_KEY=
SEARCH_MAX_RESULTS=10

# --- Memory (Obsidian) ---
OBSIDIAN_VAULT_PATH=/path/to/your/obsidian/vault
